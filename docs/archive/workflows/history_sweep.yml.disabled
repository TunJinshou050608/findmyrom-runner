name: Autonomous frozen firmware history sweep
on:
  workflow_dispatch:
    inputs:
      run_id:
        description: Empty starts discovery; continuations fill this automatically
        type: string
        default: ''
      generation:
        description: Continuation generation; leave at zero for a new experiment
        type: string
        default: '0'
permissions:
  contents: read
  actions: write
concurrency:
  group: production-extraction
  cancel-in-progress: false
jobs:
  sweep:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 120
    environment: production
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.txt
      - name: Discover, process, verify and autonomously continue the frozen experiment
        env:
          CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
          CF_D1_DATABASE_ID: ${{ secrets.CF_D1_DATABASE_ID }}
          CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          SIGN_PRIVATE_KEY_HEX: ${{ secrets.SIGN_PRIVATE_KEY_HEX }}
          GH_VAULT_TOKEN: ${{ secrets.GH_VAULT_TOKEN }}
          GH_VAULT_REPO: ${{ secrets.GH_VAULT_REPO }}
          GH_WORKFLOW_TOKEN: ${{ github.token }}
          FMR_HISTORY_CONFIG: ${{ secrets.FMR_HISTORY_CONFIG }}
          SWEEP_RUN_ID: ${{ inputs.run_id }}
          SWEEP_GENERATION: ${{ inputs.generation }}
        run: python -u -m fmr_extractor.history_sweep --run-id "$SWEEP_RUN_ID" --generation "$SWEEP_GENERATION"
