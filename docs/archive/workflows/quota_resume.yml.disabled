name: "D1 额度重置后 · 恢复增量发布"
on:
  schedule:
    - cron: '7 0 1 11 *'
  workflow_dispatch:
permissions:
  contents: read
  actions: write
concurrency:
  group: quota-reset-handoff
  cancel-in-progress: false
jobs:
  resume:
    if: github.ref == 'refs/heads/main' && (github.event_name == 'workflow_dispatch' || github.event.schedule == '7 0 1 11 *')
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: production
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - run: python -m pip install -r requirements.txt
      - name: "重置时间之后恢复厂商工作流及原实验；不盯盘"
        env:
          GH_WORKFLOW_TOKEN: ${{ github.token }}
          CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
          CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CF_D1_DATABASE_ID: ${{ secrets.CF_D1_DATABASE_ID }}
          FMR_JUMPER_ENABLED: ${{ vars.FMR_JUMPER_ENABLED }}
        run: |
          if [ "${{ github.event_name }}" != 'workflow_dispatch' ] && [ "$(date -u +%Y-%m-%d)" != '2026-11-01' ]; then exit 0; fi
          python -u -m fmr_ingest_stock.quota_resume
