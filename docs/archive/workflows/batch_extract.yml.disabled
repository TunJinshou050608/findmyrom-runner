name: Private boot image extraction
on:
  schedule:
    - cron: '17 */6 * * *'
  workflow_dispatch:
    inputs:
      dry_run:
        description: Only recover stale locks and inspect the queue
        type: boolean
        default: true
      repair_skipped:
        description: Requeue complete static ZIPs incorrectly skipped by catalogue publication
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: production-extraction
  cancel-in-progress: false
jobs:
  extract:
    # Enable only after the production secrets and private Vault are verified.
    if: github.ref == 'refs/heads/main' && vars.FMR_EXTRACTION_ENABLED == 'true' && vars.FMR_D1_WRITES_PAUSED != 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 25
    environment: production
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.txt
      - name: Extract and archive privately
        env:
          CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
          CF_D1_DATABASE_ID: ${{ secrets.CF_D1_DATABASE_ID }}
          CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          SIGN_PRIVATE_KEY_HEX: ${{ secrets.SIGN_PRIVATE_KEY_HEX }}
          GH_VAULT_TOKEN: ${{ secrets.GH_VAULT_TOKEN }}
          GH_VAULT_REPO: ${{ secrets.GH_VAULT_REPO }}
          DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && inputs.dry_run && 'true' || 'false' }}
          REPAIR_SKIPPED: ${{ inputs.repair_skipped && 'true' || 'false' }}
          FMR_D1_WRITES_PAUSED: ${{ vars.FMR_D1_WRITES_PAUSED }}
        run: |
          args=()
          if [ "$REPAIR_SKIPPED" = "true" ]; then args+=(--requeue-skipped); fi
          if [ "$DRY_RUN" = "true" ]; then
            python -u -m fmr_extractor.cli --dry-run "${args[@]}"
          else
            python -u -m fmr_extractor.cli --batch-limit 100 --max-workers 4 --max-runtime-sec 900 "${args[@]}"
          fi
