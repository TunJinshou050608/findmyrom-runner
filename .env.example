# ==============================================================================
# Local development environment configuration for Repo-Runner
#
# DO NOT commit real secrets to version control.
# In production, SIGN_PRIVATE_KEY_HEX must NEVER be committed to Git.
# It should only be stored in GitHub Actions Secrets.
#
# To generate a fresh local development keypair, run:
#   python scripts/generate_keys.py --write-dev-files
# ==============================================================================

SIGN_PRIVATE_KEY_HEX=REPLACE_WITH_YOUR_64_CHAR_HEX_ED25519_PRIVATE_KEY
LOCAL_SQLITE_PATH=dev_local.db

# Cloudflare D1 Remote Credentials (only needed when running against remote D1)
# CF_ACCOUNT_ID=your_cf_account_id
# CF_API_TOKEN=your_cf_api_token
# CF_D1_DATABASE_ID=your_d1_database_uuid

# LLM Fallback (DeepSeek API for borderline release disambiguation)
# In GitHub Actions, configure this as a GitHub Repository Secret: DEEPSEEK_API_KEY
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL_NAME=deepseek-flash
# LLM_REASONING_EFFORT=low
# LLM_API_BASE_URL=https://api.deepseek.com/v1
# LLM_MAX_TOKENS=1024
