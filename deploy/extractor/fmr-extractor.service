[Unit]
Description=FindMyROM isolated image extraction
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=fmr-extractor
Group=fmr-extractor
Slice=fmr-extraction.slice
WorkingDirectory=/opt/fmr-extractor/app
EnvironmentFile=/etc/fmr-extractor/agent.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/opt/fmr-extractor/venv/bin/python -m fmr_extractor.service
Restart=on-failure
RestartSec=10
MemoryHigh=256M
MemoryMax=352M
MemorySwapMax=0
OOMScoreAdjust=800
Nice=15
TasksMax=24
LimitNOFILE=128
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# An empty /etc hides all host service configuration, including proxy configs.
# Only DNS/NSS and public CA certificates are mounted back in, read-only.
TemporaryFileSystem=/etc:ro /run:ro /var:ro /opt:ro /usr/local/etc:ro
BindReadOnlyPaths=/opt/fmr-extractor /etc/ssl/certs /opt/fmr-extractor/runtime/resolv.conf:/etc/resolv.conf /opt/fmr-extractor/runtime/hosts:/etc/hosts /opt/fmr-extractor/runtime/nsswitch.conf:/etc/nsswitch.conf
InaccessiblePaths=-/srv -/mnt -/media
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target
